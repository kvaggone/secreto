{
  "name": "secreto",
  "version": "1.17.0",
  "description": "Send private and secure notes — end-to-end encrypted",
  "homepage": "https://secreto.info",
  "packageManager": "pnpm@9.15.0",
  "license": "Apache-2.0",
  "author": "Corentin Thomasset <corentinth@proton.me> (https://corentin.tech)",
  "repository": {
    "type": "git",
    "url": "https://github.com/kvaggone/secreto"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "release": "bumpp --commit --tag --push --recursive",
    "docker:build": "docker build -t secreto .",
    "docker:build:rootless": "docker build -f Dockerfile.rootless -t secreto:rootless .",
    "docker:run": "docker run -d -p 8788:8787 secreto"
  },
  "keywords": [
    "note",
    "secure",
    "private",
    "end-to-end",
    "encryption",
    "password",
    "manager",
    "expiration"
  ],
  "devDependencies": {
    "bumpp": "^9.5.2"
  }
}
