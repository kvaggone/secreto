{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    // Not "Node": the test files import vitest, which drags in vite's types,
    // and node10 resolution cannot read rollup's "exports" map.
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "src"
  ]
}
